// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_finder": {
    "include_ignored": "all"
  },
  "search": {
    "include_ignored": true
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
    // This setting specifically helps with icon width issues in Zed
    "font_features": {
      "calt": true
    }
  },
  "diff_view_style": "unified",
  "format_on_save": "off",
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "auto_edit"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "default_config_options": {
        "model": "claude-sonnet-4.6"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "entry_primary_click_action": "view_file",
    "group_by": "staging",
    "tree_view": true,
    "dock": "left"
  },
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true
    },
    "use_modifier_to_send": false,
    "sidebar_side": "right",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
          ]
        }
      }
    },
    "notify_when_agent_waiting": "never",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "google",
      "model": "gemini-3.1-pro-preview"
    },
    "model_parameters": []
  },
  "base_keymap": "VSCode",
  "tab_size": 2,
  "vim_mode": false,
  "ui_font_size": 17.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark"
  }
}
