				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# 1. Choose resolution (the only prompt you will see)
CHOICE=$(osascript -e 'choose from list {"720p", "1080p"} with title "Convert Video" with prompt "Choose target resolution:" default items {"1080p"}')
if [ "$CHOICE" = "false" ]; then exit 0; fi

if [ "$CHOICE" = "720p" ]; then
    SCALE="scale=-2:720"
else
    SCALE="scale=-2:1080"
fi

# 2. Process files quietly in the background
for f in "$@"; do
    if [[ "$f" == *.mov || "$f" == *.MOV ]]; then
        DIR="${f%/*}"
        BASE="${f##*/}"
        NAME="${BASE%.*}"
        OUTPUT="$DIR/${NAME}_${CHOICE}.mp4"
        
        # Run conversion quietly
        /opt/homebrew/bin/ffmpeg -i "$f" -vf "$SCALE" -c:v libx264 -pix_fmt yuv420p -c:a aac -b:a 128k -movflags +faststart -y "$OUTPUT"
    fi
done

# 3. Simple, non-intrusive system notification when finished
osascript -e "display notification \"All files successfully scaled to $CHOICE\" with title \"Conversion Complete\""</string>
