[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Carlos Ballena
	email = cballenar@gmail.com
[init]
	defaultBranch = main
[alias]
	undo = "!f() { git reset --soft HEAD~${1:-1}; }; f"
	dog = log --all --decorate --oneline --graph
	peek = checkout --detach
	# Prunes deleted tracking branches and removes them from local along with their worktrees.
	gone = "!f() { git fetch --all -p -q; git branch -vv | awk '/: gone]/{print ($1==\"*\" || $1==\"+\" ? $2 : $1)}' | while read b; do wt=$(git worktree list 2>/dev/null | grep \" \\[$b\\]$\" | sed -E \"s| +[0-9a-f]+ \\[$b\\]$||\"); [ -n \"$wt\" ] && git worktree remove \"$wt\" 2>/dev/null; git branch -D \"$b\" >/dev/null 2>&1 && echo \"Cleaned up $b\" || echo \"Skipped $b (dirty or in use)\"; done; }; f"
	# git amend-to <commit ID>
	# Creates a new commit from staged changes and squashes onto given commit ID.
	amend-to = "!f() { git commit --squash \"$1\" && git rebase -i --autosquash --autostash \"$1~1\"; }; f"
[core]
	excludesfile = /Users/cballenar/.gitignore_global
	editor = vi
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[maintenance]
	repo = /Users/cballenar/Repositories/jhsph/jhsph
	repo = /Users/cballenar/Repositories/un/undiario.pe
[fetch]
	prune = true
